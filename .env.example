# Set these in your local .env.local and in Vercel Project Settings > Environment Variables.
# Keep NEXT_PUBLIC_SITE_URL pointed at the real production domain, not localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# GA4 Admin > Data Streams > Web > Measurement ID (public identifier, not a secret).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity > Project Settings > Project ID (public identifier, not an API token).
NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id

# Optional: Search Console URL-prefix HTML-tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-search-console-verification-token
